        "path": "/page/wittyplay",
        "frame": "fullscreen"
      },
      {
        "path": "/page/wittyplay-*",
        "frame": "fullscreen"
      },
      {
        "path": "/games",
        "frame": "fullscreen"
      },
      {
        "path": "/game/:id",
        "frame": "fullscreen"
      },
