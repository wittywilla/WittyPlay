  "web": {
    "routes": [
      {
        "path": "/wittyplay/*",
        "frame": "fullscreen"
      },
      {
        "path": "/page/wittyplay",
        "frame": "fullscreen"
      },
      {
        "path": "/page/wittyplay-*",
        "frame": "fullscreen"
      },
      {
        "path": "/games",
        "frame": "fullscreen"
      },
      {
        "path": "/game/:id",
        "frame": "fullscreen"
      },
      {
        "path": "/controllers",
        "frame": "app"
      },
      {
        "path": "/games/library/:id",
        "frame": "tv"
      },
      {
        "path": "/games/game/:id",
        "frame": "tv"
      }
    ],
    "takeover": [
      {
        "libraryKind": "games",
        "route": "/wittyplay/library/{library}"
      }
    ],
    "cards": [
      {
        "mediaKind": "game",
        "art": true,
        "detail": true,
        "link": true
      }
    ],
    "settings": [
      {
        "id": "gaming",
        "label": "Games & emulators",
        "admin": true,
        "after": "channels",
        "launch": "/wittyplay/settings/store",
        "search": [
          "cores",
          "BIOS",
          "region order",
          "custom cores",
          "game streaming",
          "PCSX2",
          "Dolphin",
          "RPCS3",
          "firmware",
          "emulators"
        ]
      },
      {
        "id": "games",
        "label": "My game settings",
        "after": "appearance"
      }
    ],
    "setup": [
      {
        "id": "games",
        "title": "Games",
        "after": "details",
        "page": "wittyplay-setup",
        "version": 1,
        "later": {
          "where": "Settings, Metadata agents",
          "to": "/settings/metadata"
        }
      }
    ],
    "navFold": [
      {
        "libraryKind": "games",
        "into": "wittyplay-online"
      }
    ]
  },
  "data": {
    "store": "sqlite",
    "backup": "saves"
  },
  "lifecycle": {
    "uninstall": "ask-keep-data"
  }
}
