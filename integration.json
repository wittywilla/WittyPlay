{
  "format": "wittymodule-integration",
  "formatVersion": 1,
  "module": "wittyplay",
  "host": {
    "web": ">=5",
    "sdui": ">=8",
    "http": ">=1",
    "host": ">=1"
  },
  "feature": "games",
  "http": [
    {
      "path": "/consoles/{console}/controls",
      "methods": [
        "GET",
        "PUT"
      ],
      "auth": "user",
      "limits": {
        "body": "32KB"
      }
    },
    {
      "path": "/game-controllers",
      "methods": [
        "GET"
      ],
      "auth": "user"
    },
    {
      "path": "/game-profiles",
      "methods": [
        "GET",
        "POST"
      ],
      "auth": "user",
      "limits": {
        "body": "32KB"
      }
    },
    {
      "path": "/game-profiles/resolve",
      "methods": [
        "GET"
      ],
      "auth": "user"
    },
    {
      "path": "/game-profiles/export",
      "methods": [
        "GET"
      ],
      "auth": "user"
    },
    {
      "path": "/game-profiles/import",
      "methods": [
        "POST"
      ],
      "auth": "user",
      "limits": {
        "body": "256KB"
      }
    },
    {
      "path": "/game-profiles/{id}",
      "methods": [
        "GET",
        "PUT",
        "DELETE"
      ],
      "auth": "user",
      "limits": {
        "body": "32KB"
      }
    },
    {
      "path": "/game-profiles/{id}/copy",
      "methods": [
        "POST"
      ],
      "auth": "user"
    },
    {
      "path": "/game-profiles/{id}/active",
      "methods": [
        "POST"
      ],
      "auth": "user"
    },
    {
      "path": "/game-background",
      "methods": [
        "GET",
        "PUT",
        "DELETE"
      ],
      "auth": "user"
    },
    {
      "path": "/game-background/image",
      "methods": [
        "GET",
        "PUT"
      ],
      "auth": "user",
      "limits": {
        "body": "10MB",
        "time": "2m"
      }
    }
  ],
  "web": {
    "routes": [
      {
        "path": "/wittyplay/*",
        "frame": "fullscreen"
      },
      {
        "path": "/page/wittyplay",
        "frame": "fullscreen"
      },
      {
        "path": "/page/wittyplay-*",
        "frame": "fullscreen"
      },
      {
        "path": "/games",
        "frame": "fullscreen"
      },
      {
        "path": "/game/:id",
        "frame": "fullscreen"
      },
      {
        "path": "/controllers",
        "frame": "app"
      },
      {
        "path": "/games/library/:id",
        "frame": "tv"
      },
      {
        "path": "/games/game/:id",
        "frame": "tv"
      }
    ],
    "takeover": [
      {
        "libraryKind": "games",
        "route": "/wittyplay/library/{library}"
      }
    ],
    "cards": [
      {
        "mediaKind": "game",
        "art": true,
        "detail": true,
        "link": true
      }
    ],
    "settings": [
      {
        "id": "gaming",
        "label": "Games & emulators",
        "admin": true,
        "launch": "/wittyplay/settings/store",
        "search": [
          "cores",
          "BIOS",
          "region order",
          "custom cores",
          "game streaming",
          "PCSX2",
          "Dolphin",
          "RPCS3",
          "firmware",
          "emulators"
        ]
      },
      {
        "id": "games-support",
        "label": "What this server plays",
        "hidden": true,
        "launch": "/wittyplay/settings/store/support"
      },
      {
        "id": "emulators",
        "label": "Standalone emulators",
        "admin": true,
        "hidden": true,
        "launch": "/wittyplay/settings/store/emulators"
      },
      {
        "id": "games",
        "label": "My game settings"
      }
    ],
    "setup": [
      {
        "id": "games",
        "title": "Games",
        "after": "details",
        "later": {
          "where": "Settings, Metadata agents",
          "to": "/settings/metadata"
        }
      }
    ],
    "navFold": [
      {
        "libraryKind": "games",
        "into": "wittyplay-online"
      }
    ]
  },
  "data": {
    "store": "sqlite",
    "backup": "saves"
  },
  "lifecycle": {
    "uninstall": "ask-keep-data"
  }
}
