        "mediaKind": "game",
        "art": true,
        "detail": true,
        "link": true
      }
    ],
    "settings": [
      {
        "id": "gaming",
        "label": "Games & emulators",
        "admin": true,
        "after": "channels",
        "launch": "/wittyplay/settings/store",
        "search": [
          "cores",
          "BIOS",
          "region order",
          "custom cores",
          "game streaming",
          "PCSX2",
          "Dolphin",
          "RPCS3",
          "firmware",
