{
  "id": "wittyplay",
  "name": "WittyPlay",
  "version": "0.3.6",
  "repo": "wittywilla/WittyPlay",
  "license": "AGPL-3.0-or-later",
  "delivery": "helper",
  "entry": "wittyplay-module",
  "api": 4,
  "minServer": "0.8.0-alpha",
  "maxServer": "0.8.x",
  "capabilities": {
    "ipc": [
      "1"
    ],
    "dockerSettings": [
      "docker.enabled",
      "docker.runtime",
      "docker.network",
      "docker.internal",
      "docker.publishLoopback",
      "docker.maxContainers",
      "docker.memoryMB",
      "docker.cpus",
      "docker.pids",
      "docker.idleMinutes",
      "docker.maxHours",
      "docker.gpu",
      "docker.backend",
      "docker.images"
    ]
  },
  "group": "games",
  "summary": "Console games streamed to a browser or an app, with every controller and a touch layout editor.",
  "libraries": [
    "games"
  ],
  "needs": [
    "FFmpeg, which comes with the server",
    "Game cores, which you add in Settings, Consoles & cores"
  ],
  "updates": "All of it: the console tables, the game runner, streaming, controllers and the player.",
  "stays": "The games library, its metadata and where saves are kept stay with the server.",
  "programs": [
    "wittyplay-game-runner"
  ],
  "webEntry": "index.js",
  "webStyle": "style.css",
  "permissions": [
    "network",
    "programs",
    "devices",
    "data"
  ]
}
