//
// A frame a core drew with Vulkan, turned into NV12 on the graphics card, so a third of the
// bytes come back and the encoder takes them as they are: BT.709, limited range, which is what
// the stream is tagged with (stream/encoder.go).
//
// Each invocation does a block of 4 by 2 pixels: two 32-bit words of luma (four pixels of each
// row) and one of chroma (two blocks of 2 by 2, as U, V, U, V). The frame is padded to a width
// that's a multiple of 4 and an even height, repeating the last column and row.
//
// Compiled to nv12.spv with: glslangValidator -V --target-env vulkan1.1 nv12.comp -o nv12.spv
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(std430, binding = 1) writeonly buffer Out { uint words[]; };

layout(push_constant) uniform Params {
	uint srcW;  // the picture's size
	uint srcH;
	uint outW;  // padded: a multiple of 4
	uint outH;  // padded: even
	uint srgb;  // 1 when sampling decodes sRGB, which is then encoded again
} p;

vec3 encodeSRGB(vec3 c) {
	return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

vec3 pixel(uint x, uint y) {
	vec3 c = texelFetch(src, ivec2(min(x, p.srcW - 1u), min(y, p.srcH - 1u)), 0).rgb;
	if (p.srgb != 0u) {
		c = encodeSRGB(clamp(c, 0.0, 1.0));
	}
	return clamp(c, 0.0, 1.0);
}

// BT.709 luma, limited range: 16 to 235.
uint luma(vec3 c) {
	return uint(16.0 + 219.0 * dot(c, vec3(0.2126, 0.7152, 0.0722)) + 0.5);
}

// BT.709 chroma for a 2 by 2 block, limited range: 16 to 240, around 128.
uvec2 chroma(vec3 a, vec3 b, vec3 c, vec3 d) {
	vec3 m = (a + b + c + d) * 0.25;
	float y = dot(m, vec3(0.2126, 0.7152, 0.0722));
	float u = (m.b - y) / 1.8556;
	float v = (m.r - y) / 1.5748;
	return uvec2(uint(clamp(128.0 + 224.0 * u + 0.5, 16.0, 240.0)), uint(clamp(128.0 + 224.0 * v + 0.5, 16.0, 240.0)));
}

void main() {
	uint x0 = gl_GlobalInvocationID.x * 4u;
	uint y0 = gl_GlobalInvocationID.y * 2u;
	if (x0 >= p.outW || y0 >= p.outH) {
		return;
	}
	vec3 r0[4];
	vec3 r1[4];
	for (uint i = 0u; i < 4u; i++) {
		r0[i] = pixel(x0 + i, y0);
		r1[i] = pixel(x0 + i, y0 + 1u);
	}
	uint top = luma(r0[0]) | luma(r0[1]) << 8 | luma(r0[2]) << 16 | luma(r0[3]) << 24;
	uint bottom = luma(r1[0]) | luma(r1[1]) << 8 | luma(r1[2]) << 16 | luma(r1[3]) << 24;
	words[(y0 * p.outW + x0) / 4u] = top;
	words[((y0 + 1u) * p.outW + x0) / 4u] = bottom;
	uvec2 c0 = chroma(r0[0], r0[1], r1[0], r1[1]);
	uvec2 c1 = chroma(r0[2], r0[3], r1[2], r1[3]);
	uint uv = c0.x | c0.y << 8 | c1.x << 16 | c1.y << 24;
	words[(p.outW * p.outH + (y0 / 2u) * p.outW + x0) / 4u] = uv;
}
